r": "#A9F548FF"}, {"options": [{"content": "じゃあ買おうか？", "flag": 1}, {"content": "セットのアクセサリーとかも揃えてみる？", "flag": 2}], "say": "見てるだけで、ほっとするんです……", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 1, "say": "……いいんですか？ありがとうございます……ローラー、お気に入りの場所に飾っておきます…！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 2, "say": "ほ、本当に？じゃあ、可愛い帽子も合わせてあげたいです！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 2, "say": "えへへ、コーディネートのアイデアがどんどん溢れてきますね……！", "actorName": "ローラー", "nameColor": "#A9F548FF"}]}, {"title": "好奇心", "scripts": [{"bgm": "qe-ova-3", "bgName": "bg_project_explorer_room2", "say": "この自販機たちから……飲み物が勝手に出てくるんですか……？", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"say": "ボタンがたくさんあって、それに光ってるランプも……", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"options": [{"content": "やってみたい？手本を見せるよ", "flag": 1}, {"content": "ボタンを一通り押してみよう！", "flag": 2}], "say": "こ、こうやって操作するんでしょうか……？", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 1, "say": "わあ……す、すごい…本当に飲み物が出てきました……", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 1, "say": "頑張って使い方を覚えますっ！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 2, "say": "て、適当に押していいんですか……？", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 2, "say": "そしたら……ローラー、全部味見できますね……！", "actorName": "ローラー", "nameColor": "#A9F548FF"}]}, {"title": "アルバム作り", "scripts": [{"bgm": "qe-ova-13", "bgName": "bg_project_explorer_room3", "say": "{tb}～！これまで一緒に撮った写真を全部集めてみました！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"say": "ステッカーやリボンで飾ってみたんです！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"say": "はい、これは海に行った時、こっちはアフタヌーンティーを一緒に楽しんだ記念で……", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"say": "写真の横に、その時の気持ちも書き留めておきました！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"options": [{"content": "可愛くできてるよ", "flag": 2}, {"content": "きちんと整理されてるな", "flag": 1}], "say": "どうですか……？", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 2, "say": "えへへ、もっと可愛くデコっていきますね！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 1, "say": "心を落ち着かせて、ゆっくりまとめていくと……いい気分になりますから…！", "actorName": "ローラー", "nameColor": "#A9F548FF"}]}, {"title": "倉庫の宝探し", "scripts": [{"bgm": "qe-ova-4", "bgName": "bg_project_explorer_room3", "say": "あれ？倉庫の一番奥の棚に……見たことのないものがたくさん積まれていますね", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"say": "キラキラした羅針盤に、色とりどりのビー玉……どれも可愛いなぁ……", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"say": "えっ？隅にあるそれは……", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"say": "{tb}、ここを一緒に片付けてみませんか？", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"options": [{"content": "いいよ。一緒に片付けよう", "flag": 2}, {"content": "秘密がバレちゃったら困るな", "flag": 1}], "say": "もしかしたら、隠された秘密が見つかるかもですよ！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 2, "say": "やったぁ！倉庫の宝探し、スタートです！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 1, "say": "えっ…？本当に秘密が……{tb}？！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 1, "say": "じゃ、じゃあそっとしてあげます……", "actorName": "ローラー", "nameColor": "#A9F548FF"}]}, {"title": "健康管理", "scripts": [{"bgm": "qe-ova-13", "bgName": "bg_project_explorer_room3", "say": "{tb}、もう三時間もずっと仕事していますよ……", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"say": "ジャスミン茶を淹れて、ビタミン入りのグミも用意しました", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"options": [{"content": "仰せのままに！", "flag": 2}, {"content": "あと少しだけ……", "flag": 1}], "say": "今すぐ目を閉じて五分間休憩してください。これは命令です！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 2, "say": "えへへ、{tb}のお世話をするのもローラーの大事な役目ですから！", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 1, "say": "でも、体の方が大切ですよ……", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"optionFlag": 1, "say": "そ、それなら、せめて書類の整理だけでも手伝わせてください……！", "actorName": "ローラー", "nameColor": "#A9F548FF"}]}, {"title": "飾り計画", "scripts": [{"bgm": "qe-ova-13", "bgName": "bg_project_explorer_room3", "say": "{tb}！素敵なお飾りを見つけましたよ", "actorName": "ローラー", "nameColor": "#A9F548FF"}, {"say": "金色とオレンジのリボンを使えば、会議室をひま